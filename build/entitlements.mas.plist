<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build of the app itself. electron-builder adds the team ID, application identifier
  and application group from the provisioning profile while signing.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!--
      fetch / pull / push / clone, and the Git service APIs. Not network.server: App Review turns it
      down unless the app is a server, so the app listens on no port. Git's askpass helper reaches it
      over a Unix socket (src/main/askpass/server.ts), and GitLab and Gitea have no browser sign-in here,
      which would need a server on 127.0.0.1 (src/main/accounts/oauth.ts).
    -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Repositories and clone folders the user picks in the open dialog. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Reopening those folders after a restart (security-scoped bookmarks, src/main/folderAccess.ts). -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
  </dict>
</plist>
