{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/askpass/**/*",
    "src/shared/**/*",
    "test/**/*"
  ]
}
